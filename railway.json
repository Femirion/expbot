{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "./gradlew clean bootJar"
  },
  "deploy": {
    "startCommand": "java -XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=20 -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError -jar build/libs/*.jar"
  }
}
